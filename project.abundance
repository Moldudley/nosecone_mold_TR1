          ],
          "interpreterVersion": 1,
          "code": "/**\r\n * Nose cone from the Haack series, equation-driven spline outer profile.\r\n * Solid of revolution around the Z axis; tip at z=0, base at z=length.\r\n * length, outerDiameter in mm.\r\n * C sets the profile: 0 = LD-Haack / Von Karman (min drag for given length/diameter),\r\n * 0.333 = LV-Haack (min drag for given length/volume).\r\n */\r\nfunction run(\r\n  length: number = 100,\r\n  outerDiameter: number = 40,\r\n  C: number = 0,\r\n): Assembly {\r\n  const R = outerDiameter / 2;\r\n  const numPoints = Math.round(length * 3);\r\n\r\n  function radiusAt(x: number): number {\r\n    const theta = Math.acos(1 - (2 * x) / length);\r\n    return (\r\n      (R / Math.sqrt(Math.PI)) *\r\n      Math.sqrt(theta - Math.sin(2 * theta) / 2 + C * Math.pow(Math.sin(theta), 3))\r\n    );\r\n  }\r\n\r\n  function normalize(v: [number, number]): [number, number] {\r\n    const len = Math.hypot(v[0], v[1]);\r\n    return len === 0 ? [0, 0] : [v[0] / len, v[1] / len];\r\n  }\r\n\r\n  const curvePoints: [number, number][] = [[0, 0]];\r\n  for (let i = 1; i <= numPoints; i++) {\r\n    const x = (i / numPoints) * length;\r\n    curvePoints.push([x, radiusAt(x)]);\r\n  }\r\n\r\n  const tangents = curvePoints.map((_, i) => {\r\n    const prev = curvePoints[Math.max(0, i - 1)];\r\n    const next = curvePoints[Math.min(curvePoints.length - 1, i + 1)];\r\n    return normalize([next[0] - prev[0], next[1] - prev[1]]);\r\n  });\r\n\r\n  let pen = replicad.draw(curvePoints[0]);\r\n  for (let i = 1; i < curvePoints.length; i++) {\r\n    const [x0, y0] = curvePoints[i - 1];\r\n    const [x1, y1] = curvePoints[i];\r\n    const d = Math.hypot(x1 - x0, y1 - y0);\r\n    const t0 = tangents[i - 1];\r\n    const t1 = tangents[i];\r\n\r\n    const c1: [number, number] = [x0 + (t0[0] * d) / 3, y0 + (t0[1] * d) / 3];\r\n    const c2: [number, number] = [x1 - (t1[0] * d) / 3, y1 - (t1[1] * d) / 3];\r\n\r\n    pen = pen.cubicBezierCurveTo([x1, y1], c1, c2);\r\n  }\r\n\r\n  const profile = pen.lineTo([length, 0]).close();\r\n\r\n  const noseCone = profile\r\n    .sketchOnPlane()\r\n    .revolve([1, 0, 0], { angle: 360 })\r\n    .rotate(90, [0, 0, 0], [0, 1, 0]);\r\n\r\n  return new Assembly({\r\n    geometry: noseCone,\r\n    tags: [\"nose-cone\", \"haack-series\"],\r\n    bom: [`Haack series nose cone, length ${length}mm, outer diameter ${outerDiameter}mm, C=${C}`],\r\n  });\r\n}",
          "compiledCode": "\"use strict\";\n/**\n * Nose cone from the Haack series, equation-driven spline outer profile.\n * Solid of revolution around the Z axis; tip at z=0, base at z=length.\n * length, outerDiameter in mm.\n * C sets the profile: 0 = LD-Haack / Von Karman (min drag for given length/diameter),\n * 0.333 = LV-Haack (min drag for given length/volume).\n */\nfunction run(length = 100, outerDiameter = 40, C = 0) {\n    const R = outerDiameter / 2;\n    const numPoints = Math.round(length * 3);\n    function radiusAt(x) {\n        const theta = Math.acos(1 - (2 * x) / length);\n        return ((R / Math.sqrt(Math.PI)) *\n            Math.sqrt(theta - Math.sin(2 * theta) / 2 + C * Math.pow(Math.sin(theta), 3)));\n    }\n    function normalize(v) {\n        const len = Math.hypot(v[0], v[1]);\n        return len === 0 ? [0, 0] : [v[0] / len, v[1] / len];\n    }\n    const curvePoints = [[0, 0]];\n    for (let i = 1; i <= numPoints; i++) {\n        const x = (i / numPoints) * length;\n        curvePoints.push([x, radiusAt(x)]);\n    }\n    const tangents = curvePoints.map((_, i) => {\n        const prev = curvePoints[Math.max(0, i - 1)];\n        const next = curvePoints[Math.min(curvePoints.length - 1, i + 1)];\n        return normalize([next[0] - prev[0], next[1] - prev[1]]);\n    });\n    let pen = replicad.draw(curvePoints[0]);\n    for (let i = 1; i < curvePoints.length; i++) {\n        const [x0, y0] = curvePoints[i - 1];\n        const [x1, y1] = curvePoints[i];\n        const d = Math.hypot(x1 - x0, y1 - y0);\n        const t0 = tangents[i - 1];\n        const t1 = tangents[i];\n        const c1 = [x0 + (t0[0] * d) / 3, y0 + (t0[1] * d) / 3];\n        const c2 = [x1 - (t1[0] * d) / 3, y1 - (t1[1] * d) / 3];\n        pen = pen.cubicBezierCurveTo([x1, y1], c1, c2);\n    }\n    const profile = pen.lineTo([length, 0]).close();\n    const noseCone = profile\n        .sketchOnPlane()\n        .revolve([1, 0, 0], { angle: 360 })\n        .rotate(90, [0, 0, 0], [0, 1, 0]);\n    return new Assembly({\n        geometry: noseCone,\n        tags: [\"nose-cone\", \"haack-series\"],\n        bom: [`Haack series nose cone, length ${length}mm, outer diameter ${outerDiameter}mm, C=${C}`],\n    });\n}\n"
        },
